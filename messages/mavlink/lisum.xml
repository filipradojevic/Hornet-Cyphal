	<message id="59520" name="LISUM_ESC_STATUS">
		<description>ESC status data.</description>
		<field type="uint8_t" name="index" enum="LISUM_ESC_ID">Index of the first ESC in this message. minValue = 0, maxValue = 60, increment = 2.</field>
		<field type="float[2]" name="voltage" units="V">Input voltage supplied to the ESC.</field>
		<field type="float[2]" name="curr_motor" units="A">Current drawn by the motor.</field>
		<field type="float[2]" name="current" units="A">Total current drawn from the battery.</field>
		<field type="float[2]" name="temp_fet" units="C">Temperature of the ESC FETs.</field>
		<field type="float[2]" name="temp_motor" units="C">Temperature of the motor.</field>
		<field type="float[2]" name="rpm" units="eRPM">Motor rotational speed in electrical RPM.</field>
		<field type="float[2]" name="duty" units="%">Duty cycle of the ESC output.</field>
		<field type="float[2]" name="energy_consumed" units="Wh">Energy consumed by the motor.</field>
		<field type="float[2]" name="curr_consumed" units="Ah">Total charge consumed by the motor.</field>
	</message>

